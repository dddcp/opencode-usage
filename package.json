{
  "name": "opencode-usage",
  "version": "0.2.0",
  "type": "module",
  "description": "OpenCode TUI sidebar plugin: remaining quota for GLM (CN/global), Kimi Coding Plan and DeepSeek",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "usage",
    "quota",
    "glm",
    "kimi",
    "deepseek"
  ],
  "scripts": {
    "setup": "node scripts/install.mjs",
    "uninstall": "node scripts/install.mjs remove",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "test:live": "node test/run.mjs --live && node test/verify-resolve.mjs"
  },
  "devDependencies": {
    "@opencode/client": "2.1.2",
    "@opencode/plugin": "2.1.2",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "^22.13.9",
    "solid-js": "1.9.12",
    "typescript": "~5.9.2"
  }
}
